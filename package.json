{
  "name": "prasasti-crew-form",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply prasasti-crew-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply prasasti-crew-db --local"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "wrangler": "^4.131.1"
  }
}
