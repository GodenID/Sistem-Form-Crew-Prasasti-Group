{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prasasti-crew-form",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Site key Turnstile production (publik, aman disimpan di sini).
    // Secret key JANGAN di sini — atur via `wrangler secret put TURNSTILE_SECRET_KEY`.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEzjdfOuog2XkQTU"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prasasti-crew-db",
      "database_id": "b7188bd6-cf3f-4f90-be0b-e3b14f3376d1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
